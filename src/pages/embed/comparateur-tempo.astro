---
/** Page embarquable (iframe) : comparateur sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import CompareCalc from '../../components/tempo/CompareCalc';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Base, Heures creuses ou Tempo 2026 – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/fr/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <CompareCalc client:load lang="fr" id="embed" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/fr/`} target="_blank" rel="noopener" class="underline">Tempo Demain</a> · calcul 100 % dans le navigateur, tarif réglementé du 1er août 2026</p>
  </body>
</html>
