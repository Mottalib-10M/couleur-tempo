---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/tempo-comparison/" title="Base, Off-peak or Tempo 2026" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Base, Off-peak or Tempo comparison tool, 2026" description="Embed the Base, Off-peak or Tempo comparison free as an iframe: one code to copy, no sign-up, no cookie, regulated tariff kept up to date automatically on your page." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the comparison tool</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no fee. Consumer groups, local energy agencies, property managers and newsrooms set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the tool stays visible, the tool is not altered, and it is provided without warranty. Prices are updated on this site at every regulated tariff change: your page benefits with no work. French version: <code>{`${SITE_URL}/embed/comparateur-tempo/`}</code>.</p>
    <p>Consumption figures your visitors enter stay in their browser: nothing passes through our servers, and the embedded frame sets no cookie on your site. For any request, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/tempo-comparison/" title="Base, Off-peak or Tempo 2026" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
